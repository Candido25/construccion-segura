<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand_gold</item>
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:navigationBarColor">@color/brand_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.Launcher" parent="android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@color/brand_navy</item>
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:navigationBarColor">@color/brand_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
